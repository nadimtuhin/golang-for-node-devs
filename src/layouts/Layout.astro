---
interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  schemaType?: 'WebSite' | 'Course' | 'TechArticle';
}

const {
  title = "Go for Node.js Developers Masterclass Studio",
  description = "Interactive Go learning platform with live Go compiler, 56 lessons, microservices architecture, interview questions, LeetCode, and production Docker recipes.",
  canonicalPath = Astro.url.pathname,
  schemaType = "Course"
} = Astro.props;

import '../styles/global.css';

const siteOrigin = "https://golang-for-node-devs.vercel.app";
const canonicalUrl = new URL(canonicalPath, siteOrigin).href;
const ogImageUrl = `${siteOrigin}/og-image.png`;

// Structured Data (JSON-LD) for SEO, AEO, and GEO citation
const courseSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${siteOrigin}/#website`,
      "url": siteOrigin,
      "name": "Go for Node.js Developers Masterclass Studio",
      "description": "Interactive Golang learning platform and Rosetta Stone for Node.js and TypeScript developers.",
      "publisher": {
        "@type": "Organization",
        "name": "Go for Node Developers",
        "url": siteOrigin,
        "logo": {
          "@type": "ImageObject",
          "url": `${siteOrigin}/favicon.svg`
        }
      }
    },
    {
      "@type": "Course",
      "@id": `${siteOrigin}/#course`,
      "name": "Go for Node.js Developers Masterclass",
      "description": "Transition from Node.js and TypeScript to high-performance Golang backend development. Covers GMP runtime scheduler, Goroutines, Channels, Fiber microservices, Testcontainers, and production Docker packaging.",
      "provider": {
        "@type": "Organization",
        "name": "Go for Node Developers",
        "sameAs": siteOrigin
      },
      "educationalLevel": "Intermediate to Advanced",
      "hasCourseInstance": {
        "@type": "CourseInstance",
        "courseMode": "Online",
        "courseWorkload": "PT15H"
      },
      "inLanguage": "en"
    },
    {
      "@type": "TechArticle",
      "@id": `${canonicalUrl}#article`,
      "headline": title,
      "description": description,
      "url": canonicalUrl,
      "mainEntityOfPage": canonicalUrl,
      "inLanguage": "en",
      "author": {
        "@type": "Organization",
        "name": "Go for Node Developers"
      }
    }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon & Brand -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#007d9c" />

    <!-- OpenGraph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Go for Node.js Devs" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- AI & Generative Search / LLM Optimization (AEO / GEO) -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="help" type="text/plain" href="/llms.txt" title="LLM Documentation" />

    <!-- JSON-LD Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} />

    <!-- Google Fonts Preconnect & Styles -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- CodeMirror 5 (Eclipse Light Theme) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/eclipse.min.css" />
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/go/go.min.js"></script>
  </head>
  <body>
    <!-- Skip to main content landmark for keyboard / screen-reader accessibility -->
    <a href="#main-content" class="skip-to-content">Skip to main content</a>

    <slot />
  </body>
</html>
