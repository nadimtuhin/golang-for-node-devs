---
interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  breadcrumbs?: { name: string; item: string }[];
}

const {
  title = "Go for Node.js Devs | Interactive Book",
  description = "Learn Go with live Go compiler, 60 progressive chapters, Node.js comparisons, and 14 production architecture guides.",
  canonicalPath = Astro.url.pathname,
  breadcrumbs = []
} = Astro.props;

import '../styles/global.css';

const siteOrigin = "https://golang-for-node-devs.vercel.app";
// Ensure canonical has no trailing slash (matches vercel.json trailingSlash: false)
const cleanPath = canonicalPath.replace(/\/+$/, '') || '';
const canonicalUrl = `${siteOrigin}${cleanPath}`;
const ogImageUrl = `${siteOrigin}/og-image.png`;

const defaultBreadcrumbs = [
  { name: "Home", item: siteOrigin },
  ...(cleanPath ? [{ name: title.split('|')[0].trim(), item: canonicalUrl }] : [])
];
const activeBreadcrumbs = breadcrumbs.length > 0 ? breadcrumbs : defaultBreadcrumbs;
const isHomePage = cleanPath === '';
const ogImageAlt = "Go for Node.js Developers: 60 interactive chapters and 14 architecture guides";

const organizationId = `${siteOrigin}/#organization`;
const websiteId = `${siteOrigin}/#website`;
const courseId = `${siteOrigin}/#course`;

// Entities share stable @ids so answer engines can merge them across pages.
const organizationNode = {
  "@type": "Organization",
  "@id": organizationId,
  "name": "Go for Node Developers",
  "url": siteOrigin,
  "logo": {
    "@type": "ImageObject",
    "url": `${siteOrigin}/favicon.svg`
  },
  "sameAs": ["https://github.com/nadimtuhin/golang-for-node-devs"]
};

const websiteNode = {
  "@type": "WebSite",
  "@id": websiteId,
  "url": siteOrigin,
  "name": "Go for Node.js Developers Masterclass Studio",
  "alternateName": "Go for Node.js Devs",
  "description": "Interactive Golang learning platform and Rosetta Stone for Node.js and TypeScript developers.",
  "inLanguage": "en-US",
  "publisher": { "@id": organizationId }
};

const courseNode = {
  "@type": "Course",
  "@id": courseId,
  "name": "Go for Node.js Developers",
  "description": "Free interactive Go course for Node.js and TypeScript developers: 60 progressive chapters with a live Go compiler and 14 production architecture guides.",
  "url": `${siteOrigin}/chapters`,
  "inLanguage": "en-US",
  "provider": { "@id": organizationId },
  "isAccessibleForFree": true,
  "educationalLevel": "Intermediate",
  "coursePrerequisites": "Working knowledge of Node.js, JavaScript, or TypeScript",
  "teaches": [
    "Go syntax and type system for JavaScript developers",
    "Goroutines, channels, and context.Context",
    "HTTP APIs with net/http and Fiber",
    "database/sql connection pooling and transactions",
    "Testing, Docker packaging, and production Go services"
  ],
  "about": {
    "@type": "Thing",
    "name": "Go (programming language)",
    "sameAs": ["https://en.wikipedia.org/wiki/Go_(programming_language)", "https://www.wikidata.org/wiki/Q37227"]
  },
  "offers": {
    "@type": "Offer",
    "category": "Free",
    "price": 0,
    "priceCurrency": "USD"
  },
  "hasCourseInstance": {
    "@type": "CourseInstance",
    "courseMode": "Online"
  }
};

// Google ignores single-item breadcrumb trails, so the home page skips it.
const breadcrumbNode = activeBreadcrumbs.length > 1 ? {
  "@type": "BreadcrumbList",
  "@id": `${canonicalUrl}#breadcrumb`,
  "itemListElement": activeBreadcrumbs.map((b, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": b.name,
    "item": b.item
  }))
} : null;

const articleNode = {
  "@type": "TechArticle",
  "@id": `${canonicalUrl}#article`,
  "headline": title,
  "description": description,
  "url": canonicalUrl,
  "mainEntityOfPage": canonicalUrl,
  "image": ogImageUrl,
  "inLanguage": "en-US",
  "datePublished": "2026-10-01T00:00:00Z",
  "dateModified": "2026-10-14T00:00:00Z",
  "isPartOf": [{ "@id": websiteId }, { "@id": courseId }],
  "author": { "@id": organizationId },
  "publisher": { "@id": organizationId },
  "isAccessibleForFree": true,
  "about": [
    {
      "@type": "Thing",
      "name": "Go (programming language)",
      "sameAs": "https://en.wikipedia.org/wiki/Go_(programming_language)"
    },
    {
      "@type": "Thing",
      "name": "Node.js",
      "sameAs": "https://en.wikipedia.org/wiki/Node.js"
    }
  ]
};

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    organizationNode,
    websiteNode,
    courseNode,
    ...(breadcrumbNode ? [breadcrumbNode] : []),
    ...(isHomePage ? [] : [articleNode])
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicon, Manifest & Theme -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#007d9c" />

    <!-- OpenGraph / Facebook -->
    <meta property="og:type" content={isHomePage ? "website" : "article"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content="Go for Node.js Devs" />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- AI & Generative Search / LLM Optimization (AEO / GEO) -->
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <meta name="author" content="Go for Node Developers" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="help" type="text/plain" href="/llms.txt" title="LLM Context Documentation" />
    <link rel="alternate" type="application/rss+xml" title="RSS Feed for Go for Node.js Devs" href="/feed.xml" />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />

    <!-- JSON-LD Structured Data Schema -->
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

    <!-- Google Fonts Preconnect & Styles -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- CodeMirror 5 (Non-blocking: defer) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/theme/eclipse.min.css" />
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js" defer></script>
    <script is:inline src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/go/go.min.js" defer></script>
  </head>
  <body>
    <!-- Skip to main content landmark for accessibility -->
    <a href="#main-content" class="skip-to-content">Skip to main content</a>

    <slot />
  </body>
</html>
