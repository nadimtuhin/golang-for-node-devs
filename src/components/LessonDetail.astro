---
// Lesson Detail Component
interface Props {
  chapterKey?: string;
}
const { chapterKey = 'basic_vars' } = Astro.props;
import { chaptersData } from '../data/chapters';
const chapter = chaptersData[chapterKey] || chaptersData['basic_vars'];
---
<article class="lesson-detail-panel gitbook-article-intro" id="detailPanel" aria-labelledby="detailTitle">
  <div class="detail-badge-row gitbook-breadcrumb">
    <div style="display: flex; align-items: center; gap: 0.6rem;">
      <button id="sidebarExpandBtn" class="sidebar-expand-btn" onclick="toggleSidebar()" aria-label="Toggle Table of Contents sidebar" title="Toggle Table of Contents">☰ TOC</button>
      <span class="part-tag" id="detailPartTag">{chapter.part}</span>
    </div>
    <span class="gitbook-chapter-id" id="detailId">#{chapter.num}</span>
  </div>

  <h1 class="lesson-title gitbook-title" id="detailTitle">{chapter.title}</h1>
  <p class="lesson-desc gitbook-desc" id="detailDesc">
    {chapter.desc}
  </p>

  <div class="card-box node-box gitbook-comparison-box" role="region" aria-label="Node.js Code Comparison">
    <div class="node-header-row">
      <span class="node-tag">🟢 Node.js Equivalent</span>
      <button id="copyNodeBtn" class="copy-snippet-btn" onclick="copyNodeSnippet()" aria-label="Copy Node.js snippet to clipboard">📋 Copy</button>
    </div>
    <div class="node-code" id="detailNodeCode" tabindex="0" role="textbox" aria-readonly="true" aria-label="Node.js code example">{chapter.nodeCode}</div>
  </div>

  <div class="card-box go-why-box gitbook-callout-box" role="region" aria-label="Go Mental Model Rationale">
    <div class="go-why-title"><span aria-hidden="true">💡</span> The Go Mental Model</div>
    <p class="go-why-desc" id="detailGoWhy">
      {chapter.why}
    </p>
  </div>
</article>
