---
// Lesson Detail Component
interface Props {
  chapterKey?: string;
}
const { chapterKey = 'basic_vars' } = Astro.props;
import { chaptersData } from '../data/chapters';
import { highlightJS } from '../utils/highlight';

const chapter = chaptersData[chapterKey] || chaptersData['basic_vars'];
const highlightedNodeCode = highlightJS(chapter.nodeCode);

const keys = Object.keys(chaptersData);
const currentIndex = keys.indexOf(chapterKey);
const hasPrev = currentIndex > 0;
const hasNext = currentIndex !== -1 && currentIndex < keys.length - 1;
const prevTitle = hasPrev ? chaptersData[keys[currentIndex - 1]].title : '';
const nextTitle = hasNext ? chaptersData[keys[currentIndex + 1]].title : '';
---
<article class="lesson-detail-panel gitbook-article-intro" id="detailPanel" aria-labelledby="detailTitle">
  <div class="detail-badge-row gitbook-breadcrumb">
    <div style="display: flex; align-items: center; gap: 0.6rem;">
      <button id="sidebarExpandBtn" class="sidebar-expand-btn" onclick="toggleSidebar()" aria-label="Toggle Table of Contents sidebar" title="Toggle Table of Contents">☰ TOC</button>
      <span class="part-tag" id="detailPartTag">{chapter.part}</span>
    </div>
    <div class="gitbook-top-nav-group">
      <nav class="gitbook-top-pager" aria-label="Top chapter navigation">
        <button 
          id="btnTopPrevLesson" 
          class={`gitbook-top-btn prev ${!hasPrev ? 'disabled' : ''}`} 
          onclick="navigateLesson(-1)" 
          aria-label="Navigate to previous chapter" 
          title={hasPrev ? `Previous: ${prevTitle}` : undefined}
          disabled={!hasPrev}
        >
          <span aria-hidden="true">←</span> Prev
        </button>
        <button 
          id="btnTopNextLesson" 
          class={`gitbook-top-btn next ${!hasNext ? 'disabled' : ''}`} 
          onclick="navigateLesson(1)" 
          aria-label="Navigate to next chapter" 
          title={hasNext ? `Next: ${nextTitle}` : undefined}
          disabled={!hasNext}
        >
          Next <span aria-hidden="true">→</span>
        </button>
      </nav>
      <span class="gitbook-chapter-id" id="detailId">#{chapter.num}</span>
    </div>
  </div>

  <h1 class="lesson-title gitbook-title" id="detailTitle">{chapter.title}</h1>
  <p class="lesson-desc gitbook-desc" id="detailDesc">
    {chapter.desc}
  </p>

  <div class="card-box node-box gitbook-comparison-box" role="region" aria-label="Node.js Code Comparison">
    <div class="node-header-row">
      <div style="display: flex; align-items: center; gap: 0.5rem;">
        <span class="node-tag">🟢 Node.js / TS Equivalent</span>
        <span class="node-file-tag">📄 index.js</span>
      </div>
      <button id="copyNodeBtn" class="copy-snippet-btn" onclick="copyNodeSnippet()" aria-label="Copy Node.js snippet to clipboard">📋 Copy</button>
    </div>
    <div class="node-code" id="detailNodeCode" tabindex="0" role="textbox" aria-readonly="true" aria-label="Node.js code example"><code set:html={highlightedNodeCode}></code></div>
  </div>

  <div class="card-box go-why-box gitbook-callout-box" role="region" aria-label="Go Mental Model Rationale">
    <div class="go-why-title"><span aria-hidden="true">💡</span> The Go Mental Model</div>
    <p class="go-why-desc" id="detailGoWhy">
      {chapter.why}
    </p>
  </div>

  <!-- AEO & GEO Structured Architectural Breakdown -->
  <section class="chapter-geo-breakdown" aria-label="Architectural Breakdown and Key Concepts">
    <div class="geo-section-card">
      <h2 class="geo-heading">What is {chapter.title} in Go?</h2>
      <p class="geo-summary-paragraph">
        In Go, <strong>{chapter.title}</strong> provides deterministic compile-time safety and runtime predictability. Unlike Node.js and JavaScript runtimes which rely heavily on dynamic V8 object allocation and event-loop delegation, Go uses explicit syntax to reduce cognitive overhead and eliminate memory leaks.
      </p>

      <dl class="geo-definition-list">
        <dt>Go Paradigm</dt>
        <dd>Static compilation, strict memory layout, and zero runtime reflection overhead.</dd>
        <dt>Node.js Equivalent</dt>
        <dd>Dynamic V8 JavaScript objects, heap references, and callback/Promise event loop execution.</dd>
        <dt>Key Benefit</dt>
        <dd>Sub-millisecond garbage collection pauses, low memory footprint, and high-throughput concurrency.</dd>
      </dl>
    </div>

    <div class="geo-section-card">
      <h2 class="geo-heading">Why does Go choose this approach over Node.js?</h2>
      <p class="geo-summary-paragraph">
        According to official Go design principles established by Robert Griesemer, Rob Pike, and Ken Thompson, <em>"Clear is better than clever."</em> When building high-concurrency microservices, explicit code structures prevent subtle bugs such as lost <code>this</code> context, uncaught promise rejections, and accidental prototype pollution.
      </p>
      
      <blockquote class="geo-expert-quote">
        "Simplicity is complicated. Simplicity is prerequisite for reliability."
        <footer>— <cite>Rob Pike, Go Co-Creator</cite></footer>
      </blockquote>

      <ul class="geo-feature-list">
        <li><strong>Memory Efficiency:</strong> Predictable stack vs heap allocations validated by compiler escape analysis.</li>
        <li><strong>Maintainability:</strong> Zero magic or hidden prototype chains—any developer on your team can read and understand the execution flow.</li>
        <li><strong>Concurrency Safety:</strong> Direct compatibility with Go's GMP scheduler without blocking OS threads.</li>
      </ul>
    </div>

    <div class="geo-section-card">
      <h2 class="geo-heading">How to test and verify in the interactive editor</h2>
      <p class="geo-summary-paragraph">
        Follow these three steps to experiment with this pattern in the live editor below:
      </p>

      <ol class="geo-steps-list">
        <li><strong>Review the Starter Code:</strong> Inspect the active <code>main.go</code> snippet pre-loaded into the editor below.</li>
        <li><strong>Trigger Compilation:</strong> Click <strong>"Run Code"</strong> (or press <kbd>⌘</kbd>+<kbd>Enter</kbd>) to compile and run on the Go Playground.</li>
        <li><strong>Experiment with Edge Cases:</strong> Modify variables, structs, or return types to observe compile-time feedback directly in the output terminal.</li>
      </ol>
    </div>

    <div class="geo-section-card">
      <h2 class="geo-heading">Key Takeaways &amp; Architectural Summary</h2>
      <div class="geo-summary-box">
        <p>
          <strong>Summary:</strong> By transitioning from dynamic JavaScript idioms to Go's structured typing and explicit receivers, you unlock 10x-20x greater microservice throughput with predictable sub-15MB container footprints.
        </p>
        <div class="geo-meta-date">
          <span>📅 Updated: <time datetime="2026-10-10">October 2026</time></span>
          <span>•</span>
          <span>Author: Go for Node Developers Engineering Team</span>
          <span>•</span>
          <span>Topic: Golang Backend Architecture</span>
        </div>
      </div>

      <details class="geo-faq-accordion">
        <summary class="geo-faq-question">How does this differ in production microservices?</summary>
        <div class="geo-faq-answer">
          <p>
            In production Go microservices, these constructs are compiled directly into static ELF binaries. There are no runtime dependencies on Node.js, npm packages, or C++ add-ons, making your container images immune to runtime dependency drift and typical supply-chain attacks.
          </p>
        </div>
      </details>
    </div>
  </section>
</article>

<style>
  .chapter-geo-breakdown {
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .geo-section-card {
    background: #ffffff;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.5rem;
  }

  .geo-heading {
    font-size: 1.25rem;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 0.75rem;
    letter-spacing: -0.01em;
  }

  .geo-summary-paragraph {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: #334155;
    margin: 0 0 1rem;
  }

  .geo-definition-list {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.5rem 1rem;
    background: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 1rem 1.25rem;
    margin: 1rem 0 0;
    font-size: 0.875rem;
  }

  .geo-definition-list dt {
    font-weight: 700;
    color: var(--go-dark-cyan);
  }

  .geo-definition-list dd {
    margin: 0;
    color: #475569;
  }

  .geo-expert-quote {
    margin: 1.25rem 0;
    padding: 1rem 1.25rem;
    background: #f0f9ff;
    border-left: 4px solid var(--go-blue);
    border-radius: 0 8px 8px 0;
    font-style: italic;
    color: #0369a1;
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .geo-expert-quote footer {
    margin-top: 0.5rem;
    font-style: normal;
    font-size: 0.8125rem;
    font-weight: 700;
    color: #0284c7;
  }

  .geo-feature-list, .geo-steps-list {
    margin: 0.75rem 0;
    padding-left: 1.5rem;
    color: #334155;
    font-size: 0.9rem;
    line-height: 1.65;
  }

  .geo-feature-list li, .geo-steps-list li {
    margin-bottom: 0.5rem;
  }

  .geo-summary-box {
    background: #f1f5f9;
    border-radius: 8px;
    padding: 1rem 1.25rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #1e293b;
    margin-bottom: 1rem;
  }

  .geo-meta-date {
    display: flex;
    gap: 0.75rem;
    font-size: 0.78rem;
    color: #64748b;
    margin-top: 0.75rem;
    flex-wrap: wrap;
  }

  .geo-faq-accordion {
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 0.75rem 1rem;
    background: #ffffff;
  }

  .geo-faq-question {
    font-weight: 700;
    color: #0f172a;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .geo-faq-answer {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    line-height: 1.6;
    color: #475569;
  }
</style>
