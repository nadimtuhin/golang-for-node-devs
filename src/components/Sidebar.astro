        <div class="sidebar-search-box" role="search">
          <input type="search" id="lessonSearchInput" aria-label="Search lessons by title or keyword" placeholder="Filter lessons (e.g. map, docker, mutex)..." oninput="filterLessons(this.value)">
          <button id="clearSearchBtn" aria-label="Clear lesson search query" class="clear-search-btn" onclick="clearLessonSearch()" style="display:none;">✕</button>
        </div>
      </div>

      <div class="sidebar-part-label">Featured: Fullstack Microservice (Fiber + Mongo)</div>
