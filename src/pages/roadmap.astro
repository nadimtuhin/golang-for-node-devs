  title="Go Developer Roadmap (roadmap.sh) | Go for Node Devs" 
  description="Interactive roadmap.sh Golang developer learning path mapped directly to 60 interactive chapters and 14 architecture guides."
>
  <Header />
  <main id="main-content" role="main" style="min-height: calc(100vh - 54px); overflow-y: auto;">
    <ViewComponent />
  </main>
</Layout>
