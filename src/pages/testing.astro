---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ViewComponent from '../components/views/TestingView.astro';
---

<Layout title="Unit & Integration Testing in Go — Go for Node.js Devs" description="Exhaustive guide to testing in Go for Node.js developers: table-driven tests, mocking, sqlmock, Testcontainers, Redis, worker queues, httptest, benchmarks, and race detector.">
  <Header />
  <main id="main-content" role="main" style="min-height: calc(100vh - 54px); overflow-y: auto;">
    <ViewComponent />
  </main>
</Layout>
