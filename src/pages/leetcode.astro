---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import ViewComponent from '../components/views/LeetcodeView.astro';
---

<Layout title="LeetCode in Go (JS vs Go) | Go for Node Devs" description="Classic algorithm and data structure problems solved in Go with zero-allocation idioms vs JavaScript objects.">
  <Header />
  <main id="main-content" role="main" style="min-height: calc(100vh - 54px); overflow-y: auto;">
    <ViewComponent />
  </main>
</Layout>
